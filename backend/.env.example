# Meta Lead Ads PoC — Backend
PORT=3001
# Verification token you invent (must match what you enter in Meta App Dashboard > Webhooks)
VERIFY_TOKEN=unque_poc_verify_123
# Page Access Token from Graph API Explorer (with leads_retrieval + pages_show_list + pages_manage_metadata)
# Get it from: https://developers.facebook.com/tools/explorer/  → select your App → Get Token → Page token
# Must be the long EAA... string, NOT a numeric ID.
PAGE_ACCESS_TOKEN=PASTE_YOUR_PAGE_ACCESS_TOKEN_HERE
# Instant Form ID (numeric, from Business Suite → Instant Forms). For reference only —
# the backend learns form_id from each webhook; you pick this form in the Testing Tool.
FORM_ID=
# Optional: App Secret for X-Hub-Signature-256 verification (App Dashboard > Settings > Basic)
APP_SECRET=
# Facebook Graph version
GRAPH_VERSION=v21.0
# CORS origin for local dev (Expo Go uses LAN IP, so * is fine for PoC)
CORS_ORIGIN=*
